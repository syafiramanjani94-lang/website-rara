<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hello My Favorite</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #000000;
            color: #f8fafc;
            overflow-x: hidden;
        }

        .star-glow {
            text-shadow: 0 0 8px rgba(251, 113, 133, 0.8), 0 0 15px rgba(244, 63, 94, 0.5);
        }

        /* Smooth page transitions */
        .page-transition {
            transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
        }

        /* CSS untuk Animasi Hujan Love & Salju */
        @keyframes fallAndSway {
            0% {
                transform: translateY(-40px) translateX(0) scale(0.7);
                opacity: 0;
            }
            15% {
                opacity: 0.9;
            }
            85% {
                opacity: 0.9;
            }
            100% {
                transform: translateY(105vh) translateX(35px) scale(1.15);
                opacity: 0;
            }
        }
        .rain-particle {
            position: absolute;
            animation: fallAndSway linear infinite;
        }
        .spiderman-bubble {
            border-radius: 9999px;
            background-image: url('https://images.unsplash.com/photo-1635805737707-575885ab0820?auto=format&fit=crop&w=200&q=80');
            background-size: cover;
            background-position: center;
            overflow: hidden;
            backdrop-filter: blur(2px);
        }
        .spiderman-bubble-red {
            border: 2px solid rgba(239, 68, 68, 0.85);
            box-shadow: 0 0 16px rgba(239, 68, 68, 0.75), inset 0 0 12px rgba(220, 38, 38, 0.65);
            filter: sepia(1) hue-rotate(-50deg) saturate(5) brightness(1.15);
        }
        .spiderman-bubble-pink {
            border: 2px solid rgba(244, 114, 182, 0.85);
            box-shadow: 0 0 16px rgba(244, 114, 182, 0.75), inset 0 0 12px rgba(236, 72, 153, 0.65);
            filter: sepia(1) hue-rotate(240deg) saturate(6) brightness(1.25);
        }
    </style>
</head>
