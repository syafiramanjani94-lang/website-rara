        <!-- Background Pattern Merah Bintik Hitam di Seluruh Halaman 2 -->
        <div class="absolute inset-0 bg-[#050505] z-0"></div>
        <div class="absolute inset-0 opacity-45 bg-[radial-gradient(#ff1744_1.5px,#000000_1.5px)] [background-size:16px_16px] pointer-events-none z-0"></div>
        <div class="absolute inset-0 opacity-35 bg-[radial-gradient(#880015_2px,transparent_2px)] [background-size:24px_24px] [background-position:12px_12px] pointer-events-none z-0"></div>

        <!-- Container untuk Hujan Love & Cahaya Salju Putih -->
