    <!-- JavaScript Interaksi & Pembuatan Bintang Love -->
    <script>
        const btnGo = document.getElementById('goToPage2');
        const btnBack = document.getElementById('backToPage1');
        const startLoveBtn = document.getElementById('startLoveBtn');
        const page1 = document.getElementById('page1');
        const page2 = document.getElementById('page2');
        const starContainer = document.getElementById('starHeartContainer');
        const particleRainContainer = document.getElementById('particleRainContainer');
        const globalRainContainer = document.getElementById('globalRainContainer');
        const placeholderText = document.getElementById('placeholderText');
        const instructionText = document.getElementById('instructionText');
        const aiRobotIcon = document.getElementById('aiRobotIcon');
        const robotEmoji = document.getElementById('robotEmoji');
        
        // Elemen Musik Latar
        const backgroundMusic = document.getElementById('backgroundMusic');
        const musicToggleBtn = document.getElementById('musicToggleBtn');
        let isMusicPlaying = false;

        backgroundMusic.volume = 0.6;

        function toggleMusic() {
            if (isMusicPlaying) {
                backgroundMusic.pause();
                isMusicPlaying = false;
                musicToggleBtn.classList.remove('border-rose-500', 'shadow-[0_0_15px_rgba(244,63,94,0.6)]');
                musicToggleBtn.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" clip-rule="evenodd" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                    </svg>
                    <span class="absolute -bottom-7 right-0 whitespace-nowrap text-[10px] tracking-wider uppercase bg-rose-950/90 text-rose-300 px-2 py-0.5 rounded-full border border-rose-800/50 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">🎵 Muted</span>
                `;
            } else {
                backgroundMusic.play().then(() => {
                    isMusicPlaying = true;
                    musicToggleBtn.classList.add('border-rose-500', 'shadow-[0_0_15px_rgba(244,63,94,0.6)]');
                    musicToggleBtn.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-spin text-rose-400" style="animation-duration: 4s;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                        </svg>
                        <span class="absolute -bottom-7 right-0 whitespace-nowrap text-[10px] tracking-wider uppercase bg-rose-950/90 text-rose-300 px-2 py-0.5 rounded-full border border-rose-800/50 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">🎵 Playing</span>
                    `;
                }).catch(err => {
                    console.log("Autoplay blocked, waiting for user interaction");
                });
            }
        }

        musicToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleMusic();
        });

        // Coba mainkan musik otomatis pada interaksi pertama halaman (mengatasi batasan autoplay browser)
        document.body.addEventListener('click', function initAudioOnce() {
            if (!isMusicPlaying) {
                backgroundMusic.play().then(() => {
                    isMusicPlaying = true;
                    musicToggleBtn.classList.add('border-rose-500', 'shadow-[0_0_15px_rgba(244,63,94,0.6)]');
                }).catch(() => {});
            }
        }, { once: true });

        let rainInterval = null;

        // Fungsi Suara Cewek Ramah & Animasi Wajah Senyum Emoticon
        function speakRobotGreeting() {
            playClickSound();
            robotEmoji.textContent = '˃ᴗ˂';
            robotEmoji.style.transform = 'scale(1.3) rotate(5deg)';
            
            setTimeout(() => {
                robotEmoji.style.transform = 'scale(1) rotate(0deg)';
            }, 500);

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();

                const utterance = new SpeechSynthesisUtterance("Hi, my favorite.");
                utterance.rate = 1.0; 
                utterance.pitch = 1.2; 
                utterance.volume = 1.0;

                const voices = window.speechSynthesis.getVoices();
                const femaleVoice = voices.find(v => 
                    v.lang.startsWith('en') && (
                        v.name.toLowerCase().includes('female') || 
                        v.name.toLowerCase().includes('woman') || 
                        v.name.toLowerCase().includes('zira') || 
                        v.name.toLowerCase().includes('samantha') || 
                        v.name.toLowerCase().includes('victoria') ||
                        v.name.toLowerCase().includes('google uk english female') ||
                        v.name.toLowerCase().includes('google us english')
                    )
                ) || voices.find(v => v.lang.startsWith('en'));

                if (femaleVoice) {
                    utterance.voice = femaleVoice;
                }

                utterance.onend = () => {
                    robotEmoji.textContent = '•̀ᴗ•́';
                };

                window.speechSynthesis.speak(utterance);
            } else {
                setTimeout(() => {
                    robotEmoji.textContent = '•̀ᴗ•́';
                }, 2000);
            }
        }

        aiRobotIcon.addEventListener('click', () => {
            speakRobotGreeting();
        });

        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => {
                window.speechSynthesis.getVoices();
            };
        }

        // Fungsi Audio Web API untuk efek suara klik tombol
        function playClickSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(580, audioCtx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.08);

                gainNode.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.08);
            } catch (e) {
                // Ignore audio context errors if blocked by browser policy
            }
        }

        [btnGo, startLoveBtn, btnBack].forEach(btn => {
            if (btn) {
                btn.addEventListener('click', () => {
                    playClickSound();
                });
            }
        });

        // Fungsi Menghasilkan Efek Hujan Love, Cahaya Salju Putih Besar & Bubble Spiderman Merah/Pink
        function createRainParticle(container, isGlobal) {
            const particle = document.createElement('div');
            particle.className = 'rain-particle select-none pointer-events-none';
            
            const rand = Math.random();
            if (rand < 0.3) {
                // Bubble gambar muka Spiderman Merah atau Pink (Ukuran Besar)
                const isRed = Math.random() > 0.5;
                particle.classList.add('spiderman-bubble', isRed ? 'spiderman-bubble-red' : 'spiderman-bubble-pink');
                const size = isGlobal ? Math.floor(Math.random() * 24) + 46 : Math.floor(Math.random() * 18) + 38;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
            } else if (rand < 0.65) {
                // Partikel Hati Besar
                particle.innerHTML = Math.random() > 0.5 ? '💖' : '💗';
                particle.style.fontSize = isGlobal ? `${Math.floor(Math.random() * 16) + 20}px` : `${Math.floor(Math.random() * 12) + 16}px`;
                particle.style.filter = 'drop-shadow(0 0 6px rgba(244, 63, 94, 0.85))';
            } else {
                // Partikel Salju Putih Besar
                particle.innerHTML = '❄';
                particle.style.color = '#ffffff';
                particle.style.fontSize = isGlobal ? `${Math.floor(Math.random() * 18) + 22}px` : `${Math.floor(Math.random() * 14) + 18}px`;
                particle.style.textShadow = '0 0 10px rgba(255, 255, 255, 0.95), 0 0 20px rgba(255, 255, 255, 0.7)';
            }

            const maxW = isGlobal ? window.innerWidth : container.clientWidth;
            const startX = Math.random() * maxW;
            const duration = isGlobal ? Math.random() * 4 + 5 : Math.random() * 3 + 3.5;

            particle.style.left = `${startX}px`;
            particle.style.top = `-65px`;
            particle.style.animationDuration = `${duration}s`;

            container.appendChild(particle);

            setTimeout(() => {
                particle.remove();
            }, duration * 1000);
        }

        function startParticleRain() {
            particleRainContainer.innerHTML = '';
            globalRainContainer.innerHTML = '';
            globalRainContainer.classList.remove('hidden');
            
            rainInterval = setInterval(() => {
                if (particleRainContainer.childElementCount < 30) {
                    createRainParticle(particleRainContainer, false);
                }
                if (globalRainContainer.childElementCount < 45) {
                    createRainParticle(globalRainContainer, true);
                }
            }, 320);
        }

        // Fungsi Transisi ke Halaman Kedua
        btnGo.addEventListener('click', () => {
            btnBack.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            startLoveBtn.classList.remove('hidden', 'opacity-0');
            startLoveBtn.disabled = false;
            placeholderText.style.display = 'block';
            instructionText.textContent = "jangan lupa pencet tombolnya yaww";
            
            const oldStars = starContainer.querySelectorAll('.star-node');
            oldStars.forEach(s => s.remove());

            if (rainInterval) clearInterval(rainInterval);
            particleRainContainer.innerHTML = '';
            globalRainContainer.innerHTML = '';

            page1.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                page1.classList.add('hidden');
                page2.classList.remove('hidden');
                setTimeout(() => {
                    page2.classList.remove('opacity-0');
                    startParticleRain();
                }, 50);
            }, 300);
        });

        // Tombol Start Love diklik
        startLoveBtn.addEventListener('click', () => {
            placeholderText.style.display = 'none';
            startLoveBtn.classList.add('opacity-0');
            setTimeout(() => {
                startLoveBtn.classList.add('hidden');
            }, 300);

            instructionText.textContent = "semoga kamu tetap seperti bintang tetap selalu indah";
            
            generateStarHeart();
        });

        // Fungsi Transisi Kembali ke Halaman Pertama
        btnBack.addEventListener('click', () => {
            if (rainInterval) clearInterval(rainInterval);
            globalRainContainer.classList.add('hidden');
            globalRainContainer.innerHTML = '';
            page2.classList.add('opacity-0');
            setTimeout(() => {
                page2.classList.add('hidden');
                page1.classList.remove('hidden');
                setTimeout(() => {
                    page1.classList.remove('opacity-0', 'scale-95');
                }, 50);
            }, 300);
        });

        // Fungsi Matematis untuk Membentuk Love dari Bintang-Bintang
        function generateStarHeart() {
            const totalStars = 120;
            const totalDurationMs = 40000; // Diatur menjadi 40 detik
            const intervalPerStar = totalDurationMs / totalStars; 
            
            const width = starContainer.clientWidth;
            const height = starContainer.clientHeight;
            const centerX = width / 2;
            const centerY = height / 2 + 10;

            for (let i = 0; i < totalStars; i++) {
                const t = (i / totalStars) * Math.PI * 2;
                
                const x = 16 * Math.pow(Math.sin(t), 3);
                const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));

                const scale = Math.min(width, height) / 36;
                const finalX = centerX + x * scale;
                const finalY = centerY + y * scale;

                const star = document.createElement('div');
                star.className = 'star-node absolute text-rose-400 text-xs md:text-sm star-glow cursor-pointer transition-all duration-700 select-none opacity-0 scale-50';
                star.innerHTML = i % 2 === 0 ? '✦' : '★';
                star.style.left = `${finalX}px`;
                star.style.top = `${finalY}px`;
                
                starContainer.appendChild(star);

                setTimeout(() => {
                    star.style.opacity = '1';
                    star.style.transform = 'scale(1)';
                }, i * intervalPerStar);

                star.addEventListener('click', () => {
                    playClickSound();
                    star.style.color = '#ffffff';
                    star.style.transform = 'scale(2.2) rotate(45deg)';
                    setTimeout(() => {
                        star.style.color = '#fb7185';
                        star.style.transform = 'scale(1) rotate(0deg)';
                    }, 600);
                });
            }

            setTimeout(() => {
                instructionText.textContent = "Lingkar cinta bintang telah sempurna terbentuk!";
                btnBack.classList.remove('hidden');
                setTimeout(() => {
                    btnBack.classList.remove('opacity-0', 'pointer-events-none');
                }, 50);
            }, totalDurationMs + 800);
        }
    </script>
</body>
</html>
